{
  "name": "todo-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,astro,css,json}": [
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.2",
    "astro": "^7.4.7",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
